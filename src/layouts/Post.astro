---
import Base from './Base.astro';
import { profile, links } from '../data/site.js';
import { stamp } from '../lib/posts.js';

const { post, readingTime } = Astro.props;
const { title, desc, date, tags } = post.data;
const site = 'https://imazhar101.dev';
const path = Astro.url.pathname;
---

<Base
  title={`${title} — ${profile.handle}.dev`}
  desc={desc}
  path={path}
  ogType="article"
  published={date.toISOString()}
>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description: desc,
      datePublished: date.toISOString(),
      mainEntityOfPage: `${site}${path}`,
      author: { '@type': 'Person', name: profile.name, url: site },
    })}
  />

  <main class="grid">
    <article>
      <span class="stamp">{stamp(date)}</span>
      <h1>{title}</h1>
      <svg class="rule-hand" viewBox="0 0 230 9" fill="none" aria-hidden="true"
        ><path
          d="M2 6.2c38-3.6 76-4.4 114-2.6 34 1.6 68 2.2 112-1"
          stroke="var(--orange)"
          stroke-width="2.4"
          stroke-linecap="round"
        ></path></svg
      >
      <p class="lede">{desc}</p>
      <div class="prose"><slot /></div>
    </article>

    <aside class="margin">
      <p class="meta-hand">{readingTime} min read</p>
      <div class="card">
        <h4>filed under</h4>
        <div class="contact-links" style="margin-top:6px">
          {tags.length === 0 && <span class="chip">notes</span>}
          {tags.map((t) => <span class="chip">{t}</span>)}
        </div>
        <div class="fact" style="margin-top:12px"><span>permalink</span></div>
        <p class="out" style="font-family:var(--mono);font-size:11.5px">{path}</p>
      </div>
      <ul class="arrow-list" style="margin-top:20px">
        <li><a href="/blog/">all notes</a></li>
        <li><a href="/">home</a></li>
        <li><a href={links.x} target="_blank" rel="noopener">reply on x</a></li>
      </ul>
    </aside>
  </main>
</Base>
