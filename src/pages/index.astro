---
import Base from '../layouts/Base.astro';
import {
  profile, links, projects, packages, featured, stack, credential, specs, stats, achievements, roadmap,
} from '../data/site.js';

const stackRows = Object.entries(stack);

const site = 'https://imazhar101.dev';
const pageTitle = `${profile.name} (@${profile.handle}) — ${profile.role}`;
---

<Base title={pageTitle} desc={profile.blurb} path="/">
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: profile.name,
      alternateName: profile.handle,
      url: site,
      email: `mailto:${profile.email}`,
      jobTitle: profile.role,
      description: profile.blurb,
      address: { '@type': 'PostalAddress', addressLocality: profile.location },
      sameAs: [links.github, links.npm, links.x, links.linkedin, links.sharemydocs],
    })}
  />

  <main class="grid">
    <div>
      <!-- who -->
      <span class="stamp">hello, I'm</span>
      <h1>{profile.name} <span class="h1-sub">@{profile.handle}</span></h1>
      <svg class="rule-hand" viewBox="0 0 230 9" fill="none" aria-hidden="true"
        ><path
          d="M2 6.2c38-3.6 76-4.4 114-2.6 34 1.6 68 2.2 112-1"
          stroke="var(--orange)"
          stroke-width="2.4"
          stroke-linecap="round"
        ></path></svg
      >
      <p class="role-hand"><span class="hl">{profile.role}</span></p>
      <p class="lede">{profile.blurb}</p>
      <p class="sub">{profile.location} · <a href={`mailto:${profile.email}`}>{profile.email}</a></p>

      <!-- projects -->
      <section id="projects">
        <h2 class="hand">What I'm building</h2>
        <div class="cards">
          {
            projects.map((p) => (
              <a class="card" href={p.url} target="_blank" rel="noopener">
                <span class="tag">{p.tag}</span>
                <h4>{p.name}</h4>
                <p>{p.desc}</p>
                <span class="out">{p.outcome}</span>
              </a>
            ))
          }
        </div>
      </section>

      <!-- packages -->
      <section id="packages">
        <h2 class="hand">Open source, on npm</h2>
        <p class="sub">@{profile.handle} · MCP servers</p>
        <div class="cards">
          {
            featured.map((pkg) => (
              <a
                class="card"
                href={`https://www.npmjs.com/package/${pkg.name}`}
                target="_blank"
                rel="noopener"
              >
                <span class="pkg-head">
                  <h4>{pkg.short}</h4>
                  <span class="pkg-v">v{pkg.v}</span>
                </span>
                <span class="out">{pkg.outcome}</span>
              </a>
            ))
          }
        </div>
        <p class="viewall">
          <a href={links.npm} target="_blank" rel="noopener">
            → view all {packages.length} packages on npm</a
          >
        </p>
      </section>

      <!-- stack -->
      <section>
        <h2 class="hand">The toolbox</h2>
        {
          stackRows.map(([label, items]) => (
            <p class="stack-row">
              <span class="key">{label}</span>
              {items.map((it) => (
                <span class="chip">{it}</span>
              ))}
            </p>
          ))
        }
      </section>

      <!-- contact -->
      <section>
        <h2 class="hand">Say hello</h2>
        <div class="contact">
          <div class="avatar">{profile.handle.slice(0, 2).toUpperCase()}</div>
          <div>
            <p class="contact-name">{profile.name} <span class="muted">@{profile.handle}</span></p>
            <p class="contact-role">{profile.role}</p>
            <div class="contact-links">
              <a href={links.linkedin} target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/></svg>
                LinkedIn
              </a>
              <a href={`mailto:${profile.email}`}>
                <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M12 12.713 0 4.5V19a1.5 1.5 0 0 0 1.5 1.5h21A1.5 1.5 0 0 0 24 19V4.5l-12 8.213zM12 10.5 23.4 3H.6L12 10.5z"/></svg>
                Email
              </a>
              <a href={links.github} target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5.99.11-.78.42-1.3.76-1.6-2.66-.3-5.46-1.33-5.46-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.11-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.65 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.8 5.62-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58A12 12 0 0 0 12 .5z"/></svg>
                GitHub
              </a>
              <a href={links.x} target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor" aria-hidden="true"><path d="M18.9 1.9h3.68l-8.04 9.19L24 22.1h-7.4l-5.8-7.58-6.64 7.58H.48l8.6-9.83L0 1.9h7.6l5.24 6.93L18.9 1.9zm-1.29 18h2.04L6.48 3.99H4.29L17.61 19.9z"/></svg>
                X
              </a>
            </div>
          </div>
        </div>
        <a class="cred" href={credential.url} target="_blank" rel="noopener">
          <span class="cred-icon">◆</span>
          <span class="cred-text">
            <b>{credential.title}</b>
            <span class="muted"> — {credential.issuer}</span>
          </span>
          <span class="cred-verify">verify ↗</span>
        </a>
      </section>
    </div>

    <!-- margin column -->
    <aside class="margin">
      <div class="aside-note"><span class="arrow">↙</span>one engineer, a lot of small tools</div>

      <div class="card" style="margin-top:26px">
        <h4>on the bench</h4>
        {
          roadmap.map((r) => (
            <div class="road-item">
              <span class="road-status">{r.status}</span>
              <span class="road-text">{r.text}</span>
            </div>
          ))
        }
      </div>

      <div class="card" style="margin-top:18px">
        <h4>the basics</h4>
        {
          specs.map(([k, v]) => (
            <div class="fact">
              <span>{k}</span>
              <b>{v}</b>
            </div>
          ))
        }
      </div>

      <div class="stat-grid">
        {
          stats.map(([label, val]) => (
            <div>
              <span class="stat-val">{val}</span>
              <span class="stat-label">{label}</span>
            </div>
          ))
        }
      </div>

      <p class="meta-hand">badges picked up along the way</p>
      <div class="ach">
        {
          achievements.map((a) => (
            <span>
              {a.icon} {a.label}
              {a.x > 1 && <span class="ach-x"> ×{a.x}</span>}
            </span>
          ))
        }
      </div>
    </aside>
  </main>
</Base>
