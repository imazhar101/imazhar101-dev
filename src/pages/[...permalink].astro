---
// Dated post permalinks: /2026/10/22/short-name/
import { render } from 'astro:content';
import Post from '../layouts/Post.astro';
import { posts, permalink } from '../lib/posts.js';

export async function getStaticPaths() {
  const all = await posts();
  return all.map((post) => ({
    params: { permalink: permalink(post).replace(/^\/|\/$/g, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
const readingTime = Math.max(1, Math.round(post.body.split(/\s+/).length / 220));
---

<Post post={post} readingTime={readingTime}><Content /></Post>
