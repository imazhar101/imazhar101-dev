---
import Base from '../layouts/Base.astro';
import { profile } from '../data/site.js';

const pageTitle = `404 — not found · ${profile.handle}.dev`;
---

<!-- keep 404s out of the index; without this Google can list junk paths -->
<Base
  title={pageTitle}
  desc="That path doesn't exist on imazhar101.dev."
  path="/404"
  robots="noindex, follow"
>
  <main class="oops">
    <span class="stamp">well, this is awkward</span>
    <h1>404</h1>
    <svg class="rule-hand" viewBox="0 0 230 9" fill="none" aria-hidden="true"
      ><path
        d="M2 6.2c38-3.6 76-4.4 114-2.6 34 1.6 68 2.2 112-1"
        stroke="var(--orange)"
        stroke-width="2.4"
        stroke-linecap="round"
      ></path></svg
    >
    <p class="lede">That page isn't here. It may have been renamed, or it never existed.</p>
    <ul class="arrow-list" style="margin-top:26px;display:inline-block;text-align:left">
      <li><a href="/">back home</a></li>
      <li><a href="/blog/">read the notes</a></li>
    </ul>
  </main>
</Base>
