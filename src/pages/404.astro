---
import { profile } from '../data/site.js';

const site = 'https://imazhar101.dev';
const pageTitle = `404 — not found · ${profile.handle}.dev`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content="That path doesn't exist on imazhar101.dev." />
    <!-- keep 404s out of the index; without this Google can list junk paths -->
    <meta name="robots" content="noindex, follow" />
    <meta name="theme-color" content="#0d1117" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      // set theme before paint to avoid flash
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <main class="term" aria-label="terminal">
      <header class="bar">
        <span class="dot red"></span><span class="dot yellow"></span
        ><span class="dot green"></span>
        <span class="titlebar">{profile.handle}@dev — zsh</span>
      </header>

      <div class="screen">
        <p class="cmd"><span class="pr">$</span> <span id="path">cat .</span></p>
        <p class="out err">zsh: no such file or directory</p>

        <p class="cmd"><span class="pr">$</span> cd ~</p>
        <p class="out">
          <a href={site}>→ back to {profile.handle}.dev</a>
        </p>
      </div>
    </main>

    <script is:inline>
      // echo the path the visitor actually asked for, escaped via textContent
      (function () {
        var el = document.getElementById('path');
        if (el) el.textContent = 'cat ' + location.pathname;
      })();
    </script>

    <style is:global>
      :root {
        --bg: #0a0e14;
        --panel: #0d1117;
        --fg: #c9d1d9;
        --muted: #6e7681;
        --green: #3fb950;
        --yellow: #e3b341;
        --red: #f85149;
        --accent: #58a6ff;
        --line: #1f2630;
        --shadow: rgba(0, 0, 0, 0.5);
        --font: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
      }

      :root[data-theme='light'] {
        --bg: #eef1f5;
        --panel: #ffffff;
        --fg: #24292f;
        --muted: #57606a;
        --green: #1a7f37;
        --yellow: #9a6700;
        --red: #cf222e;
        --accent: #0969da;
        --line: #d0d7de;
        --shadow: rgba(140, 149, 159, 0.25);
      }

      @media (prefers-color-scheme: light) {
        :root:not([data-theme='dark']) {
          --bg: #eef1f5;
          --panel: #ffffff;
          --fg: #24292f;
          --muted: #57606a;
          --green: #1a7f37;
          --yellow: #9a6700;
          --red: #cf222e;
          --accent: #0969da;
          --line: #d0d7de;
          --shadow: rgba(140, 149, 159, 0.25);
        }
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 1.5rem;
        background: var(--bg);
        color: var(--fg);
        font-family: var(--font);
        font-size: 14px;
        line-height: 1.7;
      }

      .term {
        width: min(640px, 100%);
        border: 1px solid var(--line);
        border-radius: 10px;
        overflow: hidden;
        background: var(--panel);
        box-shadow: 0 18px 50px var(--shadow);
      }

      .bar {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 14px;
        border-bottom: 1px solid var(--line);
      }

      .dot {
        width: 11px;
        height: 11px;
        border-radius: 50%;
        display: inline-block;
      }
      .dot.red {
        background: var(--red);
      }
      .dot.yellow {
        background: var(--yellow);
      }
      .dot.green {
        background: var(--green);
      }

      .titlebar {
        margin-left: 6px;
        color: var(--muted);
        font-size: 12px;
      }

      .screen {
        padding: 1.5rem 1.4rem 1.8rem;
      }

      .cmd {
        margin: 0;
        color: var(--fg);
        overflow-wrap: anywhere;
      }

      .pr {
        color: var(--green);
        font-weight: 700;
        margin-right: 6px;
      }

      .out {
        margin: 0.2rem 0 1.4rem;
        color: var(--muted);
      }

      .out.err {
        color: var(--red);
      }

      .out:last-child {
        margin-bottom: 0;
      }

      a {
        color: var(--accent);
        text-decoration: none;
      }

      a:hover,
      a:focus-visible {
        text-decoration: underline;
      }
    </style>
  </body>
</html>
